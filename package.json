{
	"name": "@svyaddict/pi-git-commands",
	"version": "0.1.0",
	"description": "Pi package that adds /git status, fetch, pull, push, branch and cleanup commands, branch autocomplete and a git-aware footer with ahead/behind counters",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"pi-coding-agent",
		"git",
		"branch",
		"footer"
	],
	"author": "svyaddict (https://github.com/svyaddict)",
	"license": "MIT",
	"homepage": "https://github.com/svyaddict/pi-git-commands#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/svyaddict/pi-git-commands.git"
	},
	"bugs": {
		"url": "https://github.com/svyaddict/pi-git-commands/issues"
	},
	"files": [
		"extensions",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.5.0",
		"@earendil-works/pi-tui": "^1.5.0",
		"@types/node": "^22.20.5",
		"typescript": "^5.9.3"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	}
}
